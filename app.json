{
  "expo": {
    "name": "DRI",
    "slug": "dri-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drimobile",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F5F0",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "rw.dri.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B7A57",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "rw.dri.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DRI uses your location to set your pick-up point and, for drivers, to receive nearby trip requests."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DRI needs your photos to attach your ID, driving licence and profile photo to your driver application.",
          "cameraPermission": "DRI uses the camera to photograph your ID, driving licence and profile photo for your driver application."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleMapsAndroid": false,
      "router": {},
      "eas": {
        "projectId": "8607cd76-d59d-49eb-8567-cb69ea74f455"
      }
    },
    "owner": "kfetch"
  }
}
