# Base URL of the DRI API (no trailing slash, no /api/v1).
# .env points at production; eas.json sets the same URL for every build profile.
# For a local backend, copy this to .env.local with your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Google Maps SDK keys for native builds (restrict each to the app's package / bundle id).
# Expo Go works without them. Set via `eas env:create` for EAS builds.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
